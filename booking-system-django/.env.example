# Copy this file to .env on the server and replace every example value.
DOMAIN=reservaya.example.com
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=reservaya
POSTGRES_USER=reservaya
POSTGRES_PASSWORD=replace-with-a-long-random-password

# SMTP credentials for real confirmation/cancellation emails.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@example.com
EMAIL_HOST_PASSWORD=replace-with-your-smtp-password
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=notifications@example.com
